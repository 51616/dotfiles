+	it("allows before_turn_response handlers to inject custom messages for prompts and tool-result continuations", async () => {
+		const triggerSnapshots: string[][] = [];
+		const echoTool: AgentTool = {
+			name: "echo",
+			label: "Echo",
+			description: "Echo text back",
+			parameters: Type.Object({ text: Type.String() }),
+			execute: async (_toolCallId, params) => {
+				const text = typeof params === "object" && params !== null && "text" in params ? String(params.text) : "";
+				return { content: [{ type: "text", text }], details: { text } };
+			},
+		};
+		const harness = await createHarness({
+			tools: [echoTool],
+			extensionFactories: [
+				(pi) => {
+					pi.on("before_turn_response", async (event) => {
+						triggerSnapshots.push(
+							event.triggerMessages.map((message) =>
+								message.role === "custom" ? `custom:${message.customType}` : getMessageText(message),
+							),
+						);
+						return {
+							message: {
+								customType: `turn-hook-${triggerSnapshots.length}`,
+								content: `hook ${triggerSnapshots.length}`,
+								display: true,
+								details: { turn: triggerSnapshots.length },
+							},
+						};
+					});
+				},
+			],
+		});
+		harnesses.push(harness);
+		harness.setResponses([
+			fauxAssistantMessage([fauxToolCall("echo", { text: "hello" })], { stopReason: "toolUse" }),
+			(context) => {
+				const providerTexts = context.messages
+					.filter((message) => message.role === "user")
+					.map((message) => getMessageText(message));
+				return fauxAssistantMessage(
+					JSON.stringify({
+						hook1: providerTexts.includes("hook 1"),
+						hook2: providerTexts.includes("hook 2"),
+						hasToolResult: context.messages.some((message) => message.role === "toolResult"),
+					}),
+				);
+			},
+		]);
+
+		await harness.session.prompt("hello");
+
+		expect(triggerSnapshots).toEqual([["hello"], []]);
+		expect(getAssistantTexts(harness)).toContain('{"hook1":true,"hook2":true,"hasToolResult":true}');
+		expect(
+			harness.session.messages.filter((message) => message.role === "custom").map((message) => message.customType),
+		).toEqual(["turn-hook-1", "turn-hook-2"]);
+	});
+
+	it("passes queued steering messages through before_turn_response triggerMessages", async () => {
+		let extensionApi: ExtensionAPI | undefined;
+		const triggerSnapshots: string[][] = [];
