@@ -363,6 +363,31 @@ export class AgentSession {
 	 * happens here instead of in wrappers.
 	 */
 	private _installAgentToolHooks(): void {
+		this.agent.beforeTurn = async ({ triggerMessages }) => {
+			const runner = this._extensionRunner;
+			if (!runner?.hasHandlers("before_turn_response")) {
+				return undefined;
+			}
+
+			await this._agentEventQueue;
+
+			const hookResult = await runner.emitBeforeTurnResponse(triggerMessages);
+			if (!hookResult?.messages || hookResult.messages.length === 0) {
+				return undefined;
+			}
+
+			return {
+				messages: hookResult.messages.map((message) => ({
+					role: "custom" as const,
+					customType: message.customType,
+					content: message.content,
+					display: message.display,
+					details: message.details,
+					timestamp: Date.now(),
+				})),
+			};
+		};
+
 		this.agent.beforeToolCall = async ({ toolCall, args }) => {
 			const runner = this._extensionRunner;
 			if (!runner?.hasHandlers("tool_call")) {
@@ -1028,11 +1053,12 @@ export class AgentSession {
 			if (currentImages) {
 				userContent.push(...currentImages);
 			}
-			messages.push({
+			const userMessage: AgentMessage = {
 				role: "user",
 				content: userContent,
 				timestamp: Date.now(),
-			});
+			};
+			messages.push(userMessage);
 
 			// Inject any pending "nextTurn" messages as context alongside the user message
 			for (const msg of this._pendingNextTurnMessages) {
@@ -1046,6 +1072,7 @@ export class AgentSession {
 					expandedText,
 					currentImages,
 					this._baseSystemPrompt,
+					{ source: "user", triggerMessage: userMessage },
 				);
 				// Add all custom messages from extensions
 				if (result?.messages) {
@@ -1269,7 +1296,64 @@ export class AgentSession {
 				this.agent.steer(appMessage);
 			}
 		} else if (options?.triggerTurn) {
-			await this.agent.prompt(appMessage);
+			// Start a new LLM turn with the custom message as the trigger.
+			// Important: run the same extension lifecycle as normal prompt() so extensions
+			// can inject messages and/or modify the system prompt.
+			const messages: AgentMessage[] = [appMessage];
+
+			for (const msg of this._pendingNextTurnMessages) {
+				messages.push(msg);
+			}
+			this._pendingNextTurnMessages = [];
+
+			// Normalize content to text + optional images for before_agent_start.
+			let text = "";
+			let images: ImageContent[] | undefined;
+			if (typeof appMessage.content === "string") {
+				text = appMessage.content;
+			} else {
+				const textParts: string[] = [];
+				images = [];
+				for (const part of appMessage.content) {
+					if (part.type === "text") {
+						textParts.push(part.text);
+					} else {
+						images.push(part);
+					}
+				}
+				text = textParts.join("\n");
+				if (images.length === 0) images = undefined;
+			}
+
+			if (this._extensionRunner) {
+				const result = await this._extensionRunner.emitBeforeAgentStart(text, images, this._baseSystemPrompt, {
+					source: "customMessage",
+					triggerMessage: appMessage,
+				});
+
+				// Add all custom messages from extensions
+				if (result?.messages) {
+					for (const msg of result.messages) {
+						messages.push({
+							role: "custom",
+							customType: msg.customType,
+							content: msg.content,
+							display: msg.display,
+							details: msg.details,
+							timestamp: Date.now(),
+						});
+					}
+				}
+
+				// Apply extension-modified system prompt, or reset to base
+				if (result?.systemPrompt) {
+					this.agent.state.systemPrompt = result.systemPrompt;
+				} else {
+					this.agent.state.systemPrompt = this._baseSystemPrompt;
+				}
+			}
+
+			await this.agent.prompt(messages);
 		} else {
 			this.agent.state.messages.push(appMessage);
 			this.sessionManager.appendCustomMessageEntry(
