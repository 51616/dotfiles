+		const waitForRelease = new Promise<void>((resolve) => {
+			releaseToolExecution = resolve;
+		});
+		const waitTool: AgentTool = {
+			name: "wait",
+			label: "Wait",
+			description: "Wait for release",
+			parameters: Type.Object({}),
+			execute: async () => {
+				await waitForRelease;
+				return { content: [{ type: "text", text: "released" }], details: {} };
+			},
+		};
+		const harness = await createHarness({
+			tools: [waitTool],
+			extensionFactories: [
+				(pi) => {
+					extensionApi = pi;
+					pi.on("before_turn_response", async (event) => {
+						triggerSnapshots.push(
+							event.triggerMessages.map((message) =>
+								message.role === "custom" ? `custom:${message.customType}` : getMessageText(message),
+							),
+						);
+						return {
+							message: {
+								customType: `turn-hook-${triggerSnapshots.length}`,
+								content: `hook ${triggerSnapshots.length}`,
+								display: true,
+							},
