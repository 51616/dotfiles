+		const triggerSnapshots: string[][] = [];
+		const echoTool: AgentTool = {
+			name: "echo",
+			label: "Echo",
+			description: "Echo text back",
+			parameters: Type.Object({ text: Type.String() }),
+			execute: async (_toolCallId, params) => {
+				const text = typeof params === "object" && params !== null && "text" in params ? String(params.text) : "";
+				return {
+					content: [{ type: "text", text }],
+					details: { text },
+				};
+			},
+		};
+		const agent = new Agent({
+			initialState: { tools: [echoTool] },
+			beforeTurn: async ({ triggerMessages }) => {
+				triggerSnapshots.push(
+					triggerMessages.map((message) =>
+						getMessageText(message as { content: string | Array<{ type: string; text?: string }> }),
+					),
+				);
+				return undefined;
+			},
+			streamFn: (() => {
+				let callCount = 0;
+				return () => {
+					const stream = new MockAssistantStream();
+					queueMicrotask(() => {
+						if (callCount === 0) {
+							stream.push({
+								type: "done",
+								reason: "toolUse",
+								message: createToolCallAssistantMessage("tool-1", "echo", { text: "hello" }),
+							});
+						} else {
+							stream.push({ type: "done", reason: "stop", message: createAssistantMessage("done") });
+						}
+						callCount++;
+					});
+					return stream;
+				};
+			})(),
+		});
+
+		await agent.prompt("start");
+
+		expect(triggerSnapshots).toEqual([["start"], []]);
+	});
