+	it("calls beforeTurn with initial prompt trigger messages and injects messages before the response", async () => {
+		const triggerSnapshots: string[][] = [];
+		let providerSawInjectedMessage = false;
+		const agent = new Agent({
+			beforeTurn: async ({ triggerMessages }) => {
+				triggerSnapshots.push(
+					triggerMessages.map((message) =>
+						getMessageText(message as { content: string | Array<{ type: string; text?: string }> }),
+					),
+				);
+				return {
+					messages: [
+						{
+							role: "user",
+							content: [{ type: "text", text: "injected before response" }],
+							timestamp: Date.now(),
+						},
+					],
+				};
+			},
+			streamFn: (_model, context) => {
+				providerSawInjectedMessage = context.messages.some(
+					(message) => message.role === "user" && getMessageText(message) === "injected before response",
+				);
+				const stream = new MockAssistantStream();
+				queueMicrotask(() => {
+					stream.push({ type: "done", reason: "stop", message: createAssistantMessage("Processed") });
+				});
+				return stream;
+			},
+		});
+
+		await agent.prompt("hello");
+
+		expect(triggerSnapshots).toEqual([["hello"]]);
+		expect(providerSawInjectedMessage).toBe(true);
+		expect(
+			agent.state.messages.some(
+				(message) => message.role === "user" && getMessageText(message) === "injected before response",
+			),
+		).toBe(true);
+	});
+
