+/** Context passed to `beforeTurn`. */
+export interface BeforeTurnContext {
+	/** Current agent context for the upcoming assistant response. */
+	context: AgentContext;
+	/** Messages that triggered this response turn. Empty for tool-result continuations. */
+	triggerMessages: AgentMessage[];
+}
+
+/** Result returned from `beforeTurn`. */
+export interface BeforeTurnResult {
+	/** Additional messages to inject before the assistant response is requested. */
+	messages?: AgentMessage[];
+}
+
 export interface AgentLoopConfig extends SimpleStreamOptions {
 	model: Model<any>;
 
@@ -146,6 +160,15 @@ export interface AgentLoopConfig extends SimpleStreamOptions {
 	 */
 	transformContext?: (messages: AgentMessage[], signal?: AbortSignal) => Promise<AgentMessage[]>;
 
