@@ -149,6 +149,47 @@ function createAgentStream(): EventStream<AgentEvent, AgentMessage[]> {
 	);
 }
 
+async function appendMessages(
+	messages: AgentMessage[],
+	context: AgentContext,
+	newMessages: AgentMessage[],
+	emit: AgentEventSink,
+): Promise<void> {
+	for (const message of messages) {
+		await emit({ type: "message_start", message });
+		await emit({ type: "message_end", message });
+		context.messages.push(message);
+		newMessages.push(message);
+	}
+}
+
+async function runBeforeTurn(
+	context: AgentContext,
+	newMessages: AgentMessage[],
+	config: AgentLoopConfig,
+	signal: AbortSignal | undefined,
+	emit: AgentEventSink,
+	triggerMessages: AgentMessage[],
+): Promise<void> {
+	if (!config.beforeTurn) {
+		return;
+	}
+
+	const result = await config.beforeTurn(
+		{
+			context,
+			triggerMessages: [...triggerMessages],
+		},
+		signal,
+	);
+
+	if (!result?.messages || result.messages.length === 0) {
+		return;
+	}
+
+	await appendMessages(result.messages, context, newMessages, emit);
+}
+
 /**
  * Main loop logic shared by agentLoop and agentLoopContinue.
  */
@@ -158,7 +199,8 @@ async function runLoop(
 	config: AgentLoopConfig,
 	signal: AbortSignal | undefined,
 	emit: AgentEventSink,
-	streamFn?: StreamFn,
+	streamFn: StreamFn | undefined,
+	initialTriggerMessages: AgentMessage[],
 ): Promise<void> {
 	let firstTurn = true;
 	// Check for steering messages at start (user may have typed while waiting)
@@ -170,6 +212,8 @@ async function runLoop(
 
 		// Inner loop: process tool calls and steering messages
 		while (hasMoreToolCalls || pendingMessages.length > 0) {
+			const triggerMessages = firstTurn ? [...initialTriggerMessages, ...pendingMessages] : pendingMessages;
+
 			if (!firstTurn) {
 				await emit({ type: "turn_start" });
 			} else {
@@ -178,15 +222,12 @@ async function runLoop(
 
 			// Process pending messages (inject before next assistant response)
 			if (pendingMessages.length > 0) {
-				for (const message of pendingMessages) {
-					await emit({ type: "message_start", message });
-					await emit({ type: "message_end", message });
-					currentContext.messages.push(message);
-					newMessages.push(message);
-				}
+				await appendMessages(pendingMessages, currentContext, newMessages, emit);
 				pendingMessages = [];
 			}
 
+			await runBeforeTurn(currentContext, newMessages, config, signal, emit, triggerMessages);
+
 			// Stream assistant response
 			const message = await streamAssistantResponse(currentContext, config, signal, emit, streamFn);
 			newMessages.push(message);
