+	 * Called before each assistant response turn.
+	 *
+	 * This fires after any trigger messages for the turn have been added to the
+	 * context, but before the provider request is started. Tool-result
+	 * continuations call this with `triggerMessages = []`.
+	 */
+	beforeTurn?: (context: BeforeTurnContext, signal?: AbortSignal) => Promise<BeforeTurnResult | undefined>;
+
 	/**
