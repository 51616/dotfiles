   ├─► input (can intercept, transform, or handle)          │
@@ -437,13 +437,15 @@ pi.on("session_shutdown", async (_event, ctx) => {
 
 #### before_agent_start
 
-Fired after user submits prompt, before agent loop. Can inject a message and/or modify the system prompt.
+Fired after a turn-triggering message is prepared, before the agent loop starts. Can inject a message and/or modify the system prompt.
 
 ```typescript
 pi.on("before_agent_start", async (event, ctx) => {
-  // event.prompt - user's prompt text
+  // event.prompt - normalized text for the triggering message
   // event.images - attached images (if any)
   // event.systemPrompt - current system prompt
+  // event.source - "user" | "customMessage"
+  // event.triggerMessage - the actual message that triggered the turn
 
   return {
     // Inject a persistent message (stored in session, sent to LLM)
@@ -460,7 +462,7 @@ pi.on("before_agent_start", async (event, ctx) => {
 
 #### agent_start / agent_end
 
-Fired once per user prompt.
+Fired once per triggered agent loop.
 
 ```typescript
 pi.on("agent_start", async (_event, ctx) => {});
