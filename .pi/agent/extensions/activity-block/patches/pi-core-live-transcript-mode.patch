new file mode 100644
index 00000000..d9790c21
--- /dev/null
+++ b/packages/coding-agent/examples/extensions/live-transcript-mode.ts
@@ -0,0 +1,27 @@
+/**
+ * Transcript Mode Extension
+ *
+ * Demonstrates the split transcript controls for compact activity surfaces.
+ * Historical replay hides default tool rows and thinking blocks on `/resume` and
+ * `pi --session <id>`, while live rendering hides inline tool rows, the separate
+ * working spinner row, and live thinking during the active run.
+ */
+
+import type { ExtensionAPI } from "@mariozechner/pi-coding-agent";
+
+export default function liveTranscriptModeExtension(pi: ExtensionAPI) {
+	pi.on("session_start", async (_event, ctx) => {
+		if (!ctx.hasUI) return;
+		ctx.ui.setHistoricalTranscriptMode({ toolRows: "hide", thinking: "hide" });
+	});
+
+	pi.on("agent_start", async (_event, ctx) => {
+		if (!ctx.hasUI) return;
+		ctx.ui.setLiveTranscriptMode({ toolRows: "hide", thinking: "hide", working: "hide" });
+	});
+
+	pi.on("agent_end", async (_event, ctx) => {
+		if (!ctx.hasUI) return;
+		ctx.ui.setLiveTranscriptMode();
+	});
+}
