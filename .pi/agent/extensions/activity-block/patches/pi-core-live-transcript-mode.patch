+export interface ExtensionLiveTranscriptMode {
+	/** Show or suppress per-tool execution rows while a run is still active. */
+	toolRows?: "show" | "hide";
+	/** Show, collapse to a label, or fully hide assistant thinking blocks while a run is still active. */
+	thinking?: "show" | "collapse" | "hide";
+	/** Show or suppress the separate live working spinner row while a run is still active. */
+	working?: "show" | "hide";
