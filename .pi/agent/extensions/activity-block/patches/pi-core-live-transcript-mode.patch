diff --git a/packages/coding-agent/test/interactive-mode-live-transcript.test.ts b/packages/coding-agent/test/interactive-mode-live-transcript.test.ts
new file mode 100644
index 00000000..2aa0c584
--- /dev/null
+++ b/packages/coding-agent/test/interactive-mode-live-transcript.test.ts
@@ -0,0 +1,233 @@
+import { Container } from "@mariozechner/pi-tui";
+import stripAnsi from "strip-ansi";
+import { beforeAll, describe, expect, test, vi } from "vitest";
+import { InteractiveMode } from "../src/modes/interactive/interactive-mode.js";
+import { initTheme } from "../src/modes/interactive/theme/theme.js";
+
+function assistantMessage(content: Array<Record<string, unknown>>) {
+	return {
+		role: "assistant",
+		content,
+		stopReason: "stop",
+		usage: {
+			input: 0,
+			output: 0,
+			cacheRead: 0,
+			cacheWrite: 0,
+			totalTokens: 0,
+			cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+		},
+		api: "anthropic-messages",
+		provider: "faux",
+		model: "faux-model",
+		timestamp: Date.now(),
+	};
+}
+
+describe("InteractiveMode live transcript mode", () => {
+	beforeAll(() => {
+		initTheme("dark");
+	});
+
+	test("extension UI context updates live transcript mode and refreshes active components", () => {
+		const streamingComponent = {
+			setHideThinkingBlock: vi.fn(),
+			setSuppressHiddenThinkingLabel: vi.fn(),
+		};
+		const toolComponent = { setHidden: vi.fn() };
+		const loadingAnimation = { stop: vi.fn() };
+		const statusContainer = { clear: vi.fn(), addChild: vi.fn() };
+		const fakeThis: any = {
+			defaultLiveTranscriptMode: { toolRows: "show", thinking: "show", working: "show" },
+			liveTranscriptMode: { toolRows: "show", thinking: "show", working: "show" },
+			streamingComponent,
+			pendingTools: new Map([["tool-1", toolComponent]]),
+			loadingAnimation,
+			statusContainer,
+			hideThinkingBlock: false,
+			shouldHideLiveToolRows: (InteractiveMode as any).prototype.shouldHideLiveToolRows,
+			shouldCollapseLiveThinking: (InteractiveMode as any).prototype.shouldCollapseLiveThinking,
+			shouldHideLiveThinkingPlaceholder: (InteractiveMode as any).prototype.shouldHideLiveThinkingPlaceholder,
+			shouldHideWorkingIndicator: (InteractiveMode as any).prototype.shouldHideWorkingIndicator,
+			getStreamingThinkingHidden: (InteractiveMode as any).prototype.getStreamingThinkingHidden,
+			syncLoadingAnimationForLiveTranscriptMode: (InteractiveMode as any).prototype
+				.syncLoadingAnimationForLiveTranscriptMode,
+			setLiveTranscriptMode: (InteractiveMode as any).prototype.setLiveTranscriptMode,
+			ui: { requestRender: vi.fn() },
+		};
+
+		const uiContext = (InteractiveMode as any).prototype.createExtensionUIContext.call(fakeThis);
+		uiContext.setLiveTranscriptMode({ toolRows: "hide", thinking: "hide", working: "hide" });
+
+		expect(fakeThis.liveTranscriptMode).toEqual({ toolRows: "hide", thinking: "hide", working: "hide" });
+		expect(streamingComponent.setHideThinkingBlock).toHaveBeenCalledWith(true);
+		expect(streamingComponent.setSuppressHiddenThinkingLabel).toHaveBeenCalledWith(true);
+		expect(toolComponent.setHidden).toHaveBeenCalledWith(true);
+		expect(loadingAnimation.stop).toHaveBeenCalledTimes(1);
+		expect(statusContainer.clear).toHaveBeenCalledTimes(1);
+		expect(fakeThis.ui.requestRender).toHaveBeenCalledTimes(1);
+	});
+
+	test("extension UI context updates historical transcript mode and rebuilds replayed chat", () => {
+		const fakeThis: any = {
+			defaultHistoricalTranscriptMode: { toolRows: "show", thinking: "show" },
+			historicalTranscriptMode: { toolRows: "show", thinking: "show" },
+			streamingComponent: undefined,
+			pendingTools: new Map(),
+			rebuildChatFromMessages: vi.fn(),
+			setHistoricalTranscriptMode: (InteractiveMode as any).prototype.setHistoricalTranscriptMode,
+			ui: { requestRender: vi.fn() },
+		};
+
+		const uiContext = (InteractiveMode as any).prototype.createExtensionUIContext.call(fakeThis);
+		uiContext.setHistoricalTranscriptMode({ toolRows: "hide", thinking: "hide" });
+
+		expect(fakeThis.historicalTranscriptMode).toEqual({ toolRows: "hide", thinking: "hide" });
+		expect(fakeThis.rebuildChatFromMessages).toHaveBeenCalledTimes(1);
+		expect(fakeThis.ui.requestRender).not.toHaveBeenCalled();
+	});
+
+	test("message_start can fully hide live thinking when transcript mode requests it", async () => {
+		const fakeThis: any = {
+			isInitialized: true,
+			chatContainer: new Container(),
+			ui: { requestRender: vi.fn() },
+			footer: { invalidate: vi.fn() },
+			liveTranscriptMode: { toolRows: "show", thinking: "hide", working: "show" },
+			hideThinkingBlock: false,
+			hiddenThinkingLabel: "Thinking in activity block…",
+			shouldCollapseLiveThinking: (InteractiveMode as any).prototype.shouldCollapseLiveThinking,
+			shouldHideLiveThinkingPlaceholder: (InteractiveMode as any).prototype.shouldHideLiveThinkingPlaceholder,
+			getStreamingThinkingHidden: (InteractiveMode as any).prototype.getStreamingThinkingHidden,
+			getMarkdownThemeWithSettings: () => undefined,
+		};
+
+		await (InteractiveMode as any).prototype.handleEvent.call(fakeThis, {
+			type: "message_start",
+			message: assistantMessage([]),
+		});
+		await (InteractiveMode as any).prototype.handleEvent.call(fakeThis, {
+			type: "message_update",
+			message: assistantMessage([{ type: "thinking", thinking: "this would normally be verbose" }]),
+			assistantMessageEvent: { type: "thinking_delta", delta: "verbose", contentIndex: 0, partial: {} },
+		});
+
+		const rendered = stripAnsi(fakeThis.streamingComponent.render(80).join("\n"));
+		expect(rendered).not.toContain("Thinking in activity block…");
+		expect(rendered).not.toContain("this would normally be verbose");
+	});
+
+	test("tool execution rows are suppressed when live transcript mode hides tool rows", async () => {
+		const fakeThis: any = {
+			isInitialized: true,
+			chatContainer: new Container(),
+			ui: { requestRender: vi.fn() },
+			footer: { invalidate: vi.fn() },
+			streamingComponent: { updateContent: vi.fn() },
+			streamingMessage: undefined,
+			pendingTools: new Map(),
+			liveTranscriptMode: { toolRows: "hide", thinking: "show", working: "show" },
+			shouldHideLiveToolRows: (InteractiveMode as any).prototype.shouldHideLiveToolRows,
+			settingsManager: { getShowImages: () => false },
+			getRegisteredToolDefinition: () => undefined,
+			sessionManager: { getCwd: () => process.cwd() },
+		};
+
+		await (InteractiveMode as any).prototype.handleEvent.call(fakeThis, {
+			type: "message_update",
+			message: assistantMessage([
+				{ type: "toolCall", id: "tool-1", name: "read", arguments: { path: "README.md" } },
+			]),
+			assistantMessageEvent: { type: "toolcall_end", contentIndex: 0, toolCall: {}, partial: {} },
+		});
+		await (InteractiveMode as any).prototype.handleEvent.call(fakeThis, {
+			type: "tool_execution_start",
+			toolCallId: "tool-1",
+			toolName: "read",
+			args: { path: "README.md" },
+		});
+
+		expect(fakeThis.pendingTools.size).toBe(0);
+		expect(fakeThis.chatContainer.children).toHaveLength(0);
+	});
+
+	test("historical transcript mode suppresses replayed tool rows", () => {
+		const fakeThis: any = {
+			chatContainer: new Container(),
+			pendingTools: new Map(),
+			ui: { requestRender: vi.fn() },
+			settingsManager: { getShowImages: () => false },
+			sessionManager: { getCwd: () => process.cwd() },
+			session: { retryAttempt: 0 },
+			toolOutputExpanded: false,
+			historicalTranscriptMode: { toolRows: "hide", thinking: "show" },
+			shouldHideHistoricalToolRows: (InteractiveMode as any).prototype.shouldHideHistoricalToolRows,
+			addMessageToChat: vi.fn(),
+			getRegisteredToolDefinition: () => undefined,
+		};
+
+		(InteractiveMode as any).prototype.renderSessionContext.call(fakeThis, {
+			messages: [
+				assistantMessage([{ type: "toolCall", id: "tool-1", name: "read", arguments: { path: "README.md" } }]),
+			],
+		});
+
+		expect(fakeThis.addMessageToChat).toHaveBeenCalledWith(expect.objectContaining({ role: "assistant" }), {
+			historicalTranscript: true,
+		});
+		expect(fakeThis.chatContainer.children).toHaveLength(0);
+		expect(fakeThis.pendingTools.size).toBe(0);
+	});
+
+	test("historical transcript mode can fully hide replayed thinking blocks", () => {
+		const fakeThis: any = {
+			chatContainer: new Container(),
+			hideThinkingBlock: false,
+			hiddenThinkingLabel: "Thinking in activity block…",
+			historicalTranscriptMode: { toolRows: "show", thinking: "hide" },
+			shouldCollapseHistoricalThinking: (InteractiveMode as any).prototype.shouldCollapseHistoricalThinking,
+			shouldHideHistoricalThinkingPlaceholder: (InteractiveMode as any).prototype
+				.shouldHideHistoricalThinkingPlaceholder,
+			getHistoricalThinkingHidden: (InteractiveMode as any).prototype.getHistoricalThinkingHidden,
+			getMarkdownThemeWithSettings: () => undefined,
+		};
+
+		(InteractiveMode as any).prototype.addMessageToChat.call(
+			fakeThis,
+			assistantMessage([{ type: "thinking", thinking: "this would normally replay" }]),
+			{ historicalTranscript: true },
+		);
+
+		const rendered = stripAnsi(fakeThis.chatContainer.children[0].render(80).join("\n"));
+		expect(rendered).not.toContain("Thinking in activity block…");
+		expect(rendered).not.toContain("this would normally replay");
+	});
+
+	test("tool execution rows still render when live transcript mode uses defaults", async () => {
+		const fakeThis: any = {
+			isInitialized: true,
+			chatContainer: new Container(),
+			ui: { requestRender: vi.fn() },
+			footer: { invalidate: vi.fn() },
+			streamingComponent: { updateContent: vi.fn() },
+			streamingMessage: undefined,
+			pendingTools: new Map(),
+			liveTranscriptMode: { toolRows: "show", thinking: "show", working: "show" },
+			shouldHideLiveToolRows: (InteractiveMode as any).prototype.shouldHideLiveToolRows,
+			settingsManager: { getShowImages: () => false },
+			getRegisteredToolDefinition: () => undefined,
+			sessionManager: { getCwd: () => process.cwd() },
+			toolOutputExpanded: false,
+		};
+
+		await (InteractiveMode as any).prototype.handleEvent.call(fakeThis, {
+			type: "tool_execution_start",
+			toolCallId: "tool-1",
+			toolName: "read",
+			args: { path: "README.md" },
+		});
+
+		expect(fakeThis.pendingTools.size).toBe(1);
+		expect(fakeThis.chatContainer.children.length).toBeGreaterThan(0);
+	});
+});
