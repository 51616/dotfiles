diff --git a/packages/coding-agent/test/interactive-mode-transcript-modes.test.ts b/packages/coding-agent/test/interactive-mode-transcript-modes.test.ts
new file mode 100644
index 0000000..160e7ba
--- /dev/null
+++ b/packages/coding-agent/test/interactive-mode-transcript-modes.test.ts
@@ -0,0 +1,59 @@
+import { Container } from "@mariozechner/pi-tui";
+import { beforeAll, describe, expect, test, vi } from "vitest";
+import { AssistantMessageComponent } from "../src/modes/interactive/components/assistant-message.js";
+import { InteractiveMode } from "../src/modes/interactive/interactive-mode.js";
+import { initTheme } from "../src/modes/interactive/theme/theme.js";
+
+describe("Extension transcript modes", () => {
+	beforeAll(() => {
+		initTheme("dark");
+	});
+
+	test("createExtensionUIContext exposes setLiveTranscriptMode and setHistoricalTranscriptMode", () => {
+		const fakeThis: any = {
+			ui: { requestRender: vi.fn(), terminal: { setTitle: vi.fn() } },
+			statusContainer: { clear: vi.fn() },
+			chatContainer: new Container(),
+			settingsManager: { getTheme: vi.fn(() => "dark"), setTheme: vi.fn() },
+			session: { settingsManager: { getTheme: vi.fn(() => "dark") } },
+			editor: { handleInput: vi.fn(), setText: vi.fn(), getText: vi.fn(() => ""), getExpandedText: vi.fn(() => "") },
+			loadingAnimation: { stop: vi.fn() },
+			hideThinkingBlock: false,
+			defaultWorkingMessage: "Working...",
+			pendingWorkingMessage: undefined,
+			hiddenThinkingLabel: "Thinking...",
+			defaultHiddenThinkingLabel: "Thinking...",
+			rebuildChatFromMessages: vi.fn(),
+			applyTranscriptThinkingVisibility: vi.fn(),
+		};
+		Object.setPrototypeOf(fakeThis, (InteractiveMode as any).prototype);
+
+		const uiContext = (InteractiveMode as any).prototype.createExtensionUIContext.call(fakeThis);
+		expect(typeof uiContext.setLiveTranscriptMode).toBe("function");
+		expect(typeof uiContext.setHistoricalTranscriptMode).toBe("function");
+
+		uiContext.setHistoricalTranscriptMode({ toolRows: "hide", thinking: "hide" });
+		expect(fakeThis.rebuildChatFromMessages).toHaveBeenCalledTimes(1);
+
+		uiContext.setLiveTranscriptMode({ working: "hide" });
+		expect(fakeThis.statusContainer.clear).toHaveBeenCalled();
+		expect(fakeThis.loadingAnimation).toBeUndefined();
+	});
+
+	test("AssistantMessageComponent supports thinkingVisibility=hide", () => {
+		const message: any = {
+			role: "assistant",
+			content: [
+				{ type: "thinking", thinking: "secret reasoning" },
+				{ type: "text", text: "final" },
+			],
+			stopReason: "stop",
+		};
+
+		const component = new AssistantMessageComponent(message, "hide");
+		const rendered = component.render(80).join("\n");
+		expect(rendered).toContain("final");
+		expect(rendered).not.toContain("secret reasoning");
+		expect(rendered).not.toContain("Thinking");
+	});
+});
