diff --git a/packages/coding-agent/examples/extensions/live-transcript-mode.ts b/packages/coding-agent/examples/extensions/live-transcript-mode.ts
new file mode 100644
index 0000000..0c93fd9
--- /dev/null
+++ b/packages/coding-agent/examples/extensions/live-transcript-mode.ts
@@ -0,0 +1,27 @@
+import type { ExtensionAPI } from "@mariozechner/pi-coding-agent";
+
+/**
+ * Demonstrates live/historical transcript modes.
+ *
+ * Use:
+ *   pi --extension examples/extensions/live-transcript-mode.ts
+ */
+export default function liveTranscriptMode(pi: ExtensionAPI): void {
+	pi.on("session_start", async (_event, ctx) => {
+		if (!ctx.hasUI) return;
+		// Hide tool rows + thinking placeholders on resume/rebuild.
+		ctx.ui.setHistoricalTranscriptMode({ toolRows: "hide", thinking: "hide" });
+	});
+
+	pi.on("before_agent_start", async (_event, ctx) => {
+		if (!ctx.hasUI) return;
+		// Hide live tool rows + live thinking placeholders + the working spinner row.
+		ctx.ui.setLiveTranscriptMode({ toolRows: "hide", thinking: "hide", working: "hide" });
+	});
+
+	pi.on("agent_end", async (_event, ctx) => {
+		if (!ctx.hasUI) return;
+		// Restore defaults after the run finishes.
+		ctx.ui.setLiveTranscriptMode();
+	});
+}
