#!/usr/bin/env bash
set -euo pipefail

payload=$(cat)

# Prefer tmux when the caller is running inside tmux. `set-buffer -w`
# updates both tmux's paste buffer and, when supported by the client terminal,
# the system clipboard through tmux's clipboard integration.
if [[ -n "${TMUX:-}" ]] && command -v tmux >/dev/null 2>&1; then
  if tmux set-buffer -w -- "$payload" 2>/dev/null; then
    exit 0
  fi
fi

if command -v xclip >/dev/null 2>&1; then
  if printf '%s' "$payload" | xclip -selection clipboard; then
    exit 0
  fi
fi

if command -v wl-copy >/dev/null 2>&1; then
  if printf '%s' "$payload" | wl-copy; then
    exit 0
  fi
fi

if command -v pbcopy >/dev/null 2>&1; then
  if printf '%s' "$payload" | pbcopy; then
    exit 0
  fi
fi

printf 'pi-copy-to-clipboard: no clipboard backend available (tried tmux, xclip, wl-copy, pbcopy)\n' >&2
exit 127
